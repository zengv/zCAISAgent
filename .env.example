# ==== zCAISAgent ====
# 模型配置已迁至 config.toml（TOML 格式，Python 3.11+ 内置 tomllib）。
#
# 外部 LLM API key 统一通过系统环境变量注入（config.toml 的 key_env 字段声明变量名）：
#   AI_KEY_DS  →  DeepSeek 系列
#   AI_KEY_MS  →  ModelScope 系列
#   AI_KEY_QW  →  Qianwen 系列
# 可以用 docker-compose `environment:` / k8s env / 本地 shell `export` 设置。
# 如需本地直接 .env fallback，也可在这里添加：AI_KEY_DS=sk-xxx

# —— zCAISAgent 运行参数（均为可选，带默认值）——
ZCAISAGENT_API_KEY=dev-key
ZCAISAGENT_DEFAULT_TENANT=demo
ZCAISAGENT_DATA_DIR=.zcaisagent
ZCAISAGENT_SEED_DIR=data/seed
ZCAISAGENT_TOP_K=5
# ZCAISAGENT_NODE_TIMEOUT_S=30
# ZCAISAGENT_MAX_EVIDENCE=8
# ZCAISAGENT_INPUT_PRICE_PER_MTOK=0
# ZCAISAGENT_OUTPUT_PRICE_PER_MTOK=0

# 可选：覆盖默认 config.toml / .env 路径
# ZCAISAGENT_CONFIG_FILE=./config.toml
# ZCAISAGENT_ENV_FILE=./.env
