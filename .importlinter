[importlinter]
root_package = zcaisagent

[importlinter:contract:layered]
name = Layered architecture
type = layers
# 自上而下（上层可依赖下层），实测 `python -m importlinter.cli lint` 通过：
# api → evaluation → orchestration → capabilities → governance → ports → domain。
# governance 独立成层（依赖 ports、被 capabilities/evaluation/orchestration 复用），
# 纳入护栏后 capabilities/evaluation 对 governance 的依赖也会被自动校验。
layers =
    zcaisagent.api
    zcaisagent.evaluation
    zcaisagent.orchestration
    zcaisagent.capabilities
    zcaisagent.governance
    zcaisagent.ports
    zcaisagent.domain
